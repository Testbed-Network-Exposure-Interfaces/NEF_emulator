# copy this file to .env
# cp env-file-for-local.dev .env

DOMAIN=localhost
DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_FRONTEND=frontend
DOCKER_IMAGE_REPORT=report
DOCKER_IMAGE_PRODUCER=producer
# Backend
SERVER_NAME=localhost
SERVER_HOST=localhost
SERVER_PORT=8888
BACKEND_CORS_ORIGINS=["https://5g-api-emulator.medianetlab.eu","http://localhost"]
PROJECT_NAME=NEF_Emulator
SECRET_KEY=2D47CF2958CEC7CC86C988E9F9684
FIRST_SUPERUSER=admin@my-email.com
FIRST_SUPERUSER_PASSWORD=pass
SMTP_TLS=True
SMTP_PORT=465
SMTP_HOST=mail.host.com
SMTP_USER=user
SMTP_PASSWORD=pass
EMAILS_FROM_EMAIL=user@my-email.com
SENTRY_DSN=
USERS_OPEN_REGISTRATION=true
# AnalyticsExposure API
ANALYTICSEXPOSURE__BACKEND=stub
ANALYTICSEXPOSURE__URL=http://127.0.0.1:9090				        # For Prometheus backend
ANALYTICSEXPOSURE__POLL_INTERVAL=10
ANALYTICSEXPOSURE__TEMPORAL_GRAN_SIZE=60
ANALYTICSEXPOSURE__OFFSET_PERIOD=-60

# Postgres
# info: POSTGRES_USER value ('postgres') is hard-coded in /pgadmin/servers.json
POSTGRES_SERVER=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=pass
POSTGRES_DB=app

# PgAdmin
PGADMIN_LISTEN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@my-email.com
PGADMIN_DEFAULT_PASSWORD=pass

# Mongo 
MONGO_USER=root
MONGO_PASSWORD=pass

# MongoExpress
MONGO_EXPRESS_ENABLE_ADMIN=true

#Report
REPORT_PATH=../shared/report.json

# CAPIF

# Compose Networking
# CAPIF_ENABLED only works for NEF endpoints
# CAPIF_ENABLED=true  [NEF jwt disabled] => crt conditions: missing(403); invalid(400) 
# CAPIF_ENABLED=false [NEF jwt enabled]  => crt conditions: ignores certs
CAPIF_ENABLED=false
CAPIF_CLEANUP_ON_SHUTDOWN=false
EXTERNAL_NET=false

# NGINX (important for CAPIF integration)
# If you want use DOMAIN_NAME in k8s service description files turn set PRODUCTION to true and specify the DOMAIN_NAME variable
# PRODUCTION=true  => uses DOMAIN_NAME (e.g. nefemu.example.com)
# PRODUCTION=false => uses "https://${NGINX_HOST}:${NGINX_HTTPS}" (e.g. https://10.130.213.240:443)
PRODUCTION=true
DOMAIN_NAME=nefemu.com
NGINX_HOST=192.168.0.180
NGINX_HTTP=8080
NGINX_HTTPS=443

# OpenCAPIF SDK
CAPIF_HOST=capifcore
REGISTER_HOST=capifcore
CAPIF_HTTPS_PORT=443
CAPIF_REGISTER_PORT=8084
CAPIF_USERNAME=nef_provider
CAPIF_PASSWORD=password
DEBUG_MODE=true
